# ── Claude model (all agents — agentic loop + HiveQL conversion) ──────────────
CLAUDE_MODEL=claude-sonnet-4-6

ANTHROPIC_API_KEY=YOUR_API_KEY_HERE

# ── Supervisor mode ──────────────────────────────────────────────────────────────
# COPILOT_MODE=true  → supervisor pauses after each subagent and asks to proceed
# COPILOT_MODE=false → fully autonomous (default)
COPILOT_MODE=false

# ── Neo4j (local) ───────────────────────────────────────────────────────────────
# docker run --name neo4j -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/dtcm_local --detach neo4j:5
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=dtcm_local
