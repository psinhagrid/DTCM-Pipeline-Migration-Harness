# ── Anthropic API ────────────────────────────────────────────────────────────
# Required. Used by LiteLLM proxy to call Claude.
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── fast-rlm engine (Deno runtime) ───────────────────────────────────────────
# RLM_MODEL_API_KEY  — bearer token sent by Deno to LiteLLM (any non-empty string works)
# RLM_MODEL_BASE_URL — points Deno at the local LiteLLM proxy
# RLM_PRIMARY_MODEL  — model alias defined in rlm/litellm_config.yaml
RLM_MODEL_API_KEY=sk-ant-api03-...
RLM_MODEL_BASE_URL=http://localhost:4000
RLM_PRIMARY_MODEL=claude-sonnet-4-6

# ── Neo4j (local via Homebrew) ───────────────────────────────────────────────
# brew install neo4j && brew services start neo4j
# Set password at http://localhost:7474 on first run
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=dtcm_local
